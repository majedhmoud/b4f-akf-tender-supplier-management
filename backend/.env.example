# Copy this file to .env and fill in your local values. Never commit .env.

# Local PostgreSQL connection (installed natively, see the root README).
# Replace <your-username> with your OS user, or the user you created in PostgreSQL.
DATABASE_URL="postgresql://<your-username>@localhost:5432/akf_tender?schema=public"

# Port the API listens on.
PORT=4000

# The web app's exact origin, allowed to call the API with cookies.
WEB_ORIGIN="http://localhost:3000"

# Secrets that sign session tokens and CSRF tokens. Use long random values,
# for example from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<random-secret>"
CSRF_SECRET="<another-random-secret>"

# How long a sign-in lasts before signing in again, in hours.
SESSION_TTL_HOURS=168

# Sign-in attempts allowed per minute per IP (ENGINEERING_STANDARDS.md §2.4).
SIGN_IN_RATE_LIMIT=5

# Cookies are Secure by default; browsers accept that on http://localhost.
# Only the API tests set this to false.
COOKIE_SECURE=true

# Private folder for uploaded files, never served as a static folder (ADR 0006).
FILE_STORAGE_DIR=storage

# Secret that signs short-lived download URLs. Use a long random value.
FILE_URL_SECRET="<a-third-random-secret>"

# Public sign-up applications allowed per minute per IP (ENGINEERING_STANDARDS.md §2.4).
APPLICATION_RATE_LIMIT=5

# Background jobs (ADR 0004): Redis, installed natively.
REDIS_URL="redis://localhost:6379"

# Email through SMTP. In development, Mailpit catches everything:
# SMTP on port 1025, and its web view at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="AKF Tenders <no-reply@akf-tenders.test>"

# Secret that derives account setup tokens (ADR 0005). Use a long random value.
SETUP_TOKEN_SECRET="<a-fourth-random-secret>"
